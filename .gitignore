# ============================================
# MisRifas .gitignore
# ============================================

# Dependencias
/vendor/
node_modules/

# Entorno
.env
.env.*
!.env.example

# Logs
/logs/
*.log
*.error_log

# Uploads de usuarios (no versionar contenido)
/public/assets/uploads/*
/public/uploads/*
/uploads/*
!/public/assets/uploads/.gitkeep
!/public/uploads/.gitkeep
!/uploads/.gitkeep
!/uploads/.htaccess

# Backups
*.bak
*.bak2
*.bak3
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Cache
/cache/
*.cache

# Tools / Scripts temporales
/tools/

# Composer
composer-setup.php

# Backups de proyecto completo (pesados, no son código fuente)
/MisRifas*.zip
/database/backups/
.playwright-cli/
