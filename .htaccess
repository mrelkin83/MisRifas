# ============================================
# MISRIFAS - Apache Configuration
# DESARROLLO: /MisRifas/ | PRODUCCIÓN: /
# ============================================

# Cambiar según el entorno
SetEnvIf Request_URI "^/MisRifas/" IS_DEV

# Habilitar RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Sin RewriteBase: la sustitucion relativa "index.php" se resuelve contra
    # el directorio de este .htaccess, asi que funciona igual bajo
    # localhost/MisRifas/ que bajo un vhost en la raiz (misrifas.test).
    # Con RewriteBase /MisRifas/ hardcodeado, cualquier URL inexistente en el
    # vhost entraba en bucle de rewrites y terminaba en 500.

    # Forzar HTTPS en producción (se excluye localhost/127.0.0.1 para no
    # romper el entorno de desarrollo local sin TLS). Va primero, antes de
    # cualquier otra regla, para que ningún request se procese en texto plano.
    # Detrás de Cloudflare/proxy el TLS termina en el borde y el origen recibe
    # HTTP con X-Forwarded-Proto: https; en ese caso NO se redirige (evita el
    # bucle de redirección clásico de Cloudflare "Flexible/Full").
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pasar el header Authorization a PHP (mod_fcgid/CGI lo descarta por
    # defecto, rompiendo toda la autenticacion Bearer de vendors/admin/users)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Bloquear acceso directo a archivos/carpetas sensibles
    RewriteRule ^config/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^api/config/ - [F,L]
    RewriteRule ^api/utils/ - [F,L]
    # api/cron y api/workers son scripts de cola/cron sin guard CLI ni auth
    # (duplicados legacy de cron/, que sí lo tienen). Accesibles por HTTP
    # dispararían el envío de correos encolados: solo deben correr por CLI.
    RewriteRule ^api/cron/ - [F,L]
    RewriteRule ^api/workers/ - [F,L]
    # tools/ tiene scripts de migracion/seed sin autenticacion que
    # ESCRIBEN en la base de datos (ej. seed_data.php marca rifas como
    # completadas e inventa numeros ganadores) - nunca deben ser
    # accesibles por HTTP, solo por CLI.
    RewriteRule ^tools/ - [F,L]
    RewriteRule ^tests/ - [F,L]
    # storage/ guarda boletas y comprobantes FUERA del alcance web; se sirven
    # solo por controladores (api/tickets/boleta_png.php).
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^composer-setup\.php$ - [F,L]

    # NO redireccionar si ya existe el archivo o directorio
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # /api/ y /tapazo/ van directamente al filesystem (con o sin prefijo
    # /MisRifas segun el entorno)
    RewriteCond %{REQUEST_URI} !^(/MisRifas)?/api/
    RewriteCond %{REQUEST_URI} !^(/MisRifas)?/tapazo/
    
    # Todo lo demas va al front controller (index.php)
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# ============================================
# SEGURIDAD
# ============================================

# Desactivar listado de directorios
Options -Indexes

# Prevenir acceso a archivos ocultos y sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|log|sql|md|git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ============================================
# COMPRESIÓN
# ============================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ============================================
# CACHE
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# ============================================
# MIME TYPES
# ============================================

<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/css css
    AddType image/svg+xml svg svgz
    AddType application/font-woff woff
    AddType application/font-woff2 woff2
    AddType font/ttf ttf
    AddType font/otf otf
</IfModule>

# ============================================
# UTF-8 Encoding
# ============================================

AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json .rss .atom
</IfModule>
