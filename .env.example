# ============================================
# MisRifas - Variables de entorno
# ============================================
# Copiar a .env y completar con valores reales. .env nunca se versiona
# (ver .gitignore) - este archivo solo documenta qué variables existen
# y qué forma tienen, sin secretos reales.

# ── Aplicación ─────────────────────────────
APP_ENV=development
# development | production - controla cookies secure, display_errors, etc.
APP_DEBUG=false
# Local: http://localhost/MisRifas  ·  Producción: https://misrifas.online
APP_URL=http://localhost/MisRifas
APP_TIMEZONE=America/Bogota
# Clave larga y aleatoria, única por entorno (ej: openssl rand -hex 32)
APP_SECRET_KEY=

# ── Base de datos ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=misrifas
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ── Sesión / seguridad ─────────────────────
SESSION_LIFETIME=120
CSRF_TOKEN_LIFETIME=3600
PASSWORD_MIN_LENGTH=8
# Clave para autorizar la ejecución de los scripts en cron/ vía HTTP,
# si se disparan por request en vez de por cron del sistema operativo.
CRON_ENABLED=true
CRON_SECRET_KEY=

# ── Rate limiting ──────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MINUTES=1

# ── Reglas de negocio (rifas/boletos) ──────
MIN_TICKET_PRICE=1000
MAX_TICKET_PRICE=1000000
MAX_TICKETS_PER_PURCHASE=10
RESERVATION_HOURS_DEFAULT=0.25
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ── Email / SMTP (notificaciones) ──────────
# La app solo ENVÍA (notificaciones + campañas), habla SMTP estándar. Opciones:
#   1) Servidor de correo propio open-source en el VPS (recomendado para no
#      depender de Gmail/Brevo ni sus límites): Postal (self-hosted, tipo
#      Mailgun/SendGrid). Instálalo con deploy/install-vps.sh --mail y apunta
#      SMTP_HOST=127.0.0.1 SMTP_PORT=25 con las credenciales que cree Postal.
#      Alternativa ligera de un solo binario: Stalwart.
#   2) Un relay externo (Brevo/SES) si no quieres administrar entregabilidad.
# En ambos casos hay que crear los registros DNS SPF, DKIM y DMARC de
# misrifas.online o el correo caerá a spam.
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@misrifas.online
EMAIL_FROM_NAME=MisRifas
#   3) VPS de PRUEBAS sin salida SMTP real (EC2 bloquea el puerto 25): Mailpit
#      (captura los correos y los muestra en http://127.0.0.1:8025):
#      SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_USER=misrifas SMTP_PASS=misrifas
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# ── WhatsApp gestionado (Evolution API de la plataforma) ──────────
# Servidor Evolution COMPARTIDO que la plataforma pone para todos los
# organizadores: ellos solo escanean el QR desde su perfil; jamás ven estas
# credenciales. Vacío = el autoservicio de WhatsApp queda "Próximamente" y
# cada vendedor puede seguir usando su servidor propio si lo configura.
WA_EVOLUTION_URL=
WA_EVOLUTION_APIKEY=

# ── SMS (open-source, Gammu SMSD + módem GSM) ──────────
# El microservicio sms-service/ encola SMS en la bandeja de salida de Gammu
# SMSD (open-source, requiere un módem/dongle GSM USB con SIM). Si Gammu usa
# el backend SQLite, apunta esta ruta al archivo de su base de datos.
SMS_ENABLED=false
GAMMU_SMSD_DB=

# ── WhatsApp (motor de IA / Evolution API) ─
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Pagos: Wompi ────────────────────────────
# Además de estas variables globales, cada vendor puede guardar sus
# propias credenciales de Wompi (vendors.payment_config) desde su panel.
WOMPI_ENABLED=false
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=
WOMPI_MERCHANT_ID=

# ── Pagos: Nequi (si se activa el canal directo) ─
NEQUI_ENABLED=false
NEQUI_API_URL=
NEQUI_API_KEY=
NEQUI_API_SECRET=
NEQUI_MERCHANT_ID=
NEQUI_WEBHOOK_SECRET=

# ── Pagos: Mercado Pago (opcional) ─────────
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Login social ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── SEO / metadatos por defecto ────────────
META_TITLE="MisRifas - Rifas Digitales en Colombia"
META_DESCRIPTION="La plataforma más confiable para crear y participar en rifas digitales en Colombia."
META_KEYWORDS="rifas,sorteos,colombia,boletos digitales"
META_IMAGE=

# ── Cache (opcional, no implementado activamente hoy) ─
CACHE_ENABLED=false
CACHE_DRIVER=file

# ── Logging ─────────────────────────────────
LOG_LEVEL=error
LOG_FILE_PATH=logs/app.log
ERROR_LOG_FILE_PATH=logs/error.log
